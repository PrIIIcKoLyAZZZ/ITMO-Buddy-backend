# Replace every REPLACE_* value before use. Keep .env local and use shell-safe values.
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts='localhost;127.0.0.1;[::1]'
Https__Port=7110

POSTGRES_USER=itmo_buddy
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_DB=itmo_buddy
ConnectionStrings__Postgres='Host=127.0.0.1;Port=2438;Database=itmo_buddy;Username=itmo_buddy;Password=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD'

Jwt__Issuer=itmo-buddy-local
Jwt__Audience=itmo-buddy-local-client
Jwt__SigningKey=REPLACE_WITH_BASE64_KEY
Jwt__AccessTokenLifetime=00:30:00

Minio__InternalEndpoint=http://127.0.0.1:9000
Minio__ExternalEndpoint=https://storage.itmo-buddy.test:9443
Minio__AccessKey=REPLACE_WITH_LOCAL_MINIO_ACCESS_KEY
Minio__SecretKey=REPLACE_WITH_LOCAL_MINIO_SECRET_KEY
Minio__BucketName=itmo-buddy-local
Minio__Region=us-east-1
Minio__PresignedUrlLifetime=00:05:00
FileCleanup__Enabled=false

# Optional. Uncomment only for an actual frontend origin or trusted proxy.
# Cors__AllowedOrigins__0=https://localhost:3000
# ReverseProxy__KnownProxies__0=192.0.2.10
# ReverseProxy__KnownNetworks__0=192.0.2.16/28
ReverseProxy__ForwardLimit=1

RateLimiting__LoginFailureCount=5
RateLimiting__LoginFailureWindow=00:10:00
RateLimiting__MaxTrackedLoginIps=10000
RateLimiting__Login__PermitLimit=60
RateLimiting__Login__Window=00:01:00
RateLimiting__Register__PermitLimit=12
RateLimiting__Register__Window=00:10:00
RateLimiting__Refresh__PermitLimit=60
RateLimiting__Refresh__Window=00:01:00
RateLimiting__Tags__PermitLimit=30
RateLimiting__Tags__Window=00:01:00
RateLimiting__Photo__PermitLimit=10
RateLimiting__Photo__Window=00:01:00
RateLimiting__Messages__PermitLimit=120
RateLimiting__Messages__Window=00:01:00
