# For an existing PostgreSQL volume, reuse its initialized POSTGRES_* values.
# Use simple PostgreSQL database and user names, for example itmo_buddy.
POSTGRES_USER=itmo_buddy
POSTGRES_DB=itmo_buddy
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_BASE64_KEY
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=itmo-buddy-local
CORS_ORIGIN_0=https://localhost:5173
CORS_ORIGIN_1=https://localhost:3000

# Set all three values together if the default subnet is already in use.
# CADDY_SUBNET=172.31.243.0/28
# CADDY_DYNAMIC_RANGE=172.31.243.8/29
# CADDY_IP=172.31.243.2
